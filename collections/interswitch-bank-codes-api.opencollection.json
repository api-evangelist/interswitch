{
  "opencollection": "1.0.0",
  "info": {
    "name": "Interswitch Recharge Airtime Bank Codes API",
    "version": "2024-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bank Codes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Banks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.interswitchng.com/quicktellerservice/api/v5/banks"
          },
          "docs": "Return CBN bank codes and bank names that can be addressed via the transfer endpoints."
        }
      ]
    }
  ],
  "bundled": true
}