          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.interswitchng.com/api/v2/quickteller/categorys/:categoryId/billers",
            "params": [
              {
                "name": "categoryId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Billers In Category"
        },
        {
          "info": {
            "name": "List All Billers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.interswitchng.com/api/v2/quickteller/billers"
          },
          "docs": "List All Billers"
        }
      ]
    }
  ],
  "bundled": true
}