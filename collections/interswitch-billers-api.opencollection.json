{
  "opencollection": "1.0.0",
  "info": {
    "name": "Interswitch Recharge Airtime Billers API",
    "version": "2024-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Billers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Biller Categories",
