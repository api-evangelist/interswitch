{
  "opencollection": "1.0.0",
  "info": {
    "name": "Interswitch Recharge Airtime Payment Items API",
    "version": "2024-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Biller Payment Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.interswitchng.com/api/v2/quickteller/billers/:billerId/paymentitems",
            "params": [
              {
                "name": "billerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns supported amounts, packages, or denominations for the biller (e.g. DSTV Compact, MTN-100 airtime)."
        }
      ]
    }
  ],
  "bundled": true
}