{
  "opencollection": "1.0.0",
  "info": {
    "name": "Interswitch Recharge Airtime Payments API",
    "version": "2024-01-01"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit Bill Payment Advice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.interswitchng.com/api/v2/quickteller/payments/advices",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit Bill Payment Advice"
        },
        {
          "info": {
            "name": "Generate Lending Payment Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.interswitchng.com/lending-service/api/v2/payments/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate Lending Payment Token"
        },
        {
          "info": {
            "name": "Validate Lending Payment Token OTP",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.interswitchng.com/lending-service/api/v2/payments/token/validate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Validate Lending Payment Token OTP"
        },
        {
          "info": {
            "name": "Create Card Payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.interswitchng.com/paymentgateway/api/v1/payments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authorize and capture a card payment using a tokenized or hosted-field-collected card."
        },
        {
          "info": {
            "name": "Get Payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.interswitchng.com/paymentgateway/api/v1/payments/:paymentId",
            "params": [
              {
                "name": "paymentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Payment"
        }
      ]
    }
  ],
  "bundled": true
}